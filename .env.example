# Run pnpm setup:local to create .env with a random local DB password.
# These are examples, not production credentials. Never commit .env or .data.
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://temple:CHANGE_ME@127.0.0.1:5432/temple
REDIS_URL=redis://127.0.0.1:6379
MAIL_MODE=file
MAIL_OUTBOX_DIR=.data/mail-outbox
ADMIN_MFA_KEY_FILE=.data/mfa-key
TTS_PROVIDER=mock
TTS_CACHE_DIR=.data/tts
# Optional, only after choosing an authorized provider and testing the bridge:
# LIVE_WEBHOOK_SECRET_FILE=.data/live-webhook-secret
# Optional real TTS: TTS_PROVIDER=openai and OPENAI_API_KEY via secure settings.
# Optional real email: MAIL_MODE=smtp, SMTP_URL and MAIL_FROM via secure settings.
# Production API runs separately from `pnpm worker`.
# PRODUCTION: set NODE_ENV=production, serve behind HTTPS, keep TRUST_PROXY off
# unless the reverse proxy strips untrusted X-Forwarded-* headers.
TRUST_PROXY=0
